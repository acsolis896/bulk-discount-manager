// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model BlockedProductType {
  id          String   @id @default(cuid())
  shop        String
  productType String
  createdAt   DateTime @default(now())

  @@unique([shop, productType])
  @@index([shop])
}

model PreUsedCode {
  id         String   @id @default(cuid())
  shop       String
  discountId String
  code       String
  createdAt  DateTime @default(now())

  @@unique([shop, code])
  @@index([shop, discountId])
}

model IssuedCode {
  id         String   @id @default(cuid())
  shop       String
  discountId String
  code       String
  createdAt  DateTime @default(now())

  @@unique([shop, code])
  @@index([shop, discountId])
}

model SingleCodeDiscount {
  id                  String   @id @default(cuid())
  shop                String
  discountId          String
  code                String
  requiredTag         String   @default("")
  blockedTag          String   @default("")
  eligibilityMode     String?
  segmentId           String?
  configJson          String?
  eligibleCustomerIds String?
  blockedCustomerIds  String?
  usesPerCustomerLimit Int?
  functionNodeId      String?
  createdAt           DateTime @default(now())

  @@unique([shop, discountId])
  @@index([shop])
}

// Tracks how many times each customer has redeemed a given reusable code, so
// a code can cap usage per customer (e.g. "5 uses each") — something
// Shopify's discount API has no native support for beyond a flat
// once-per-customer toggle. Populated by the orders/create webhook.
model CodeUsageCount {
  id         String   @id @default(cuid())
  shop       String
  discountId String
  customerId String
  count      Int      @default(0)
  updatedAt  DateTime @updatedAt

  @@unique([shop, discountId, customerId])
  @@index([shop, discountId])
}

// One row per (order, code) redemption, populated by the orders/create
// webhook. Shopify exposes a per-code usage count natively but no per-code
// revenue, so this is the only source for the "Code performance" reporting
// on the discount detail pages.
model CodeRedemption {
  id         String   @id @default(cuid())
  shop       String
  discountId String
  code       String
  orderId    String
  orderName  String
  totalPrice Float
  currency   String
  customerId String?
  createdAt  DateTime @default(now())

  @@unique([shop, orderId, code])
  @@index([shop, discountId])
  @@index([shop, code])
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}
