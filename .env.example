# Copy to .env for local development. Never commit real values.
# Use a SEPARATE dev Shopify app and a SEPARATE database from production.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=
SCOPES=write_discounts,read_products,read_customers,write_customers,read_orders
DATABASE_URL=postgresql://user:password@localhost:5432/discount_codes_dev

# STAGING ONLY. Makes the app behave as this plan (Free, Starter or Pro), because the staging
# app has no Shopify App Pricing plans. Never set this on the production service.
# PLAN_TIER_OVERRIDE=Pro
